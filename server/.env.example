# Tirgumim account server. Copy to .env (never commit .env) and fill in. See ../ENTITLEMENTS.md.

# Where it listens, and the https address players' launchers and browsers reach it at.
PORT=8787
PUBLIC_URL=https://accounts.example.org
# Behind a reverse proxy (Caddy, nginx, a cloud load balancer): take the client IP from X-Forwarded-For.
TRUST_PROXY=false

DATABASE_PATH=./data/tirgumim.db
# Paid pack zips: PACKS_DIR/<gameId>/<file>.zip, registered with PUT /v1/admin/packs/<gameId>.
PACKS_DIR=./packs

# Ed25519 signing key for entitlement lists and download grants: `npm run keygen` prints a new one.
# The launcher has the matching PUBLIC key built in. Keep this one secret (a secret manager in production).
ENTITLEMENT_SIGNING_KEY=
ENTITLEMENT_KEY_ID=k1
# How long a signed list works offline (seconds). The launcher never accepts more than 14 days + 1 hour.
ENTITLEMENT_TTL_SECONDS=1209600

# Owner/admin API (approve, revoke, prices, packs). At least 32 random characters; empty disables the admin API.
ADMIN_TOKEN=

# Payments (Stripe Checkout). Both empty: the store shows "not for sale yet" and checkout answers
# PAYMENTS_NOT_CONFIGURED.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=https://accounts.example.org/v1/checkout/done
CHECKOUT_CANCEL_URL=https://accounts.example.org/v1/checkout/cancelled

# Email. No provider chosen yet: sign-in links are printed to the server log (fine for testing, not for players).
MAIL_FROM=
