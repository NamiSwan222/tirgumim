{
  "name": "tirgumim-launcher",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "Tirgumim launcher: installs Hebrew translation packs into games",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:dev-catalog": "tauri dev -- -- --dev-catalog",
    "release": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "make-pack": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- --make-pack",
    "dev:setup": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- --dev-setup",
    "check-catalog": "cargo run --quiet --manifest-path src-tauri/Cargo.toml -- --check-catalog catalog/catalog.json",
    "publish-launcher": "node scripts/publish-launcher.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
